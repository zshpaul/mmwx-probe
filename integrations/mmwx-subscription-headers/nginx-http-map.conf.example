# Include inside http {}. This finite guard is deliberately not a general
# recursive URL decoder. Encoded prefixes outside these forms can pass through.
map "$request_method:$request_uri" $mmwx_reject_subscription_uri {
    default 0;
    "~*^(?:GET|HEAD):/%(?:25)*78(?:/|%(?:25)*2f)" 1;
    "~*^(?:GET|HEAD):/(?:/|%(?:25)*2f)+(?:x|%(?:25)*78)(?:/|%(?:25)*2f)" 1;
    "~*^(?:GET|HEAD):/x%(?:25)*2f" 1;
    "~*^(?:GET|HEAD):/x/[^?]*%" 1;
    "~^(?:GET|HEAD):/x//" 1;
    "~^(?:GET|HEAD):/x/(?:[^?]*/)?\.{1,2}(?:/|$|\?)" 1;
    "~*^(?:GET|HEAD):/(?:[^/?]+/)*(?:%(?:25)*2e|\.){1,2}(?:/|%(?:25)*2f)(?:x|%(?:25)*78)(?:/|%(?:25)*2f)" 1;
}
